# 로봇 전체 상태 메시지
string nav_state          # IDLE / NAVIGATING / PAUSED / ESTOP
string estop_state        # NORMAL / ESTOP
string current_goal_id    # 현재 목표 destination_id (없으면 빈 문자열)
float64 current_x         # 현재 위치 x
float64 current_y         # 현재 위치 y
float64 current_yaw       # 현재 방향 (라디안)
float64 battery_percent   # 배터리 잔량 (확장용)
