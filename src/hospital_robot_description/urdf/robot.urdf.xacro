<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="hospital_robot">

  <!-- 휠 -->
  <xacro:property name="wheel_radius" value="0.0325"/>
  <xacro:property name="wheel_width" value="0.018"/>
  <xacro:property name="wheel_separation" value="0.171"/>
  <xacro:property name="wheel_mass" value="0.5"/>

  <!-- 차체 (사각형으로 변경) -->
  <xacro:property name="base_length" value="0.285"/>   <!-- X축 (앞뒤) -->
  <xacro:property name="base_width" value="0.280"/>    <!-- Y축 (좌우) -->
  <xacro:property name="base_height" value="0.242"/>   <!-- Z축 (높이) -->
  <xacro:property name="base_mass" value="8.0"/>

  <!-- 센서 위치 -->
  <xacro:property name="lidar_x_offset" value="0.10"/>
  <xacro:property name="lidar_z_ground" value="0.101"/>   <!-- 10.1cm -->
  <xacro:property name="camera_x_offset" value="0.152"/>
  <xacro:property name="camera_z_ground" value="0.056"/>

  <!-- 기타 -->
  <xacro:property name="caster_radius" value="0.025"/>
  <xacro:property name="caster_mass" value="0.2"/>
  <xacro:property name="lidar_size" value="0.06"/>
  <xacro:property name="lidar_height" value="0.04"/>
  <xacro:property name="camera_size" value="0.03"/>

  <material name="white"><color rgba="0.95 0.95 0.95 1"/></material>
  <material name="dark_grey"><color rgba="0.3 0.3 0.3 1"/></material>
  <material name="black"><color rgba="0.1 0.1 0.1 1"/></material>
  <material name="red"><color rgba="0.8 0.2 0.2 1"/></material>

  <xacro:macro name="cylinder_inertia" params="m r h">
    <inertial>
      <mass value="${m}"/>
      <inertia ixx="${(1/12)*m*(3*r*r+h*h)}" ixy="0" ixz="0" iyy="${(1/12)*m*(3*r*r+h*h)}" iyz="0" izz="${(1/2)*m*r*r}"/>
    </inertial>
  </xacro:macro>

  <xacro:macro name="sphere_inertia" params="m r">
    <inertial>
      <mass value="${m}"/>
      <inertia ixx="${(2/5)*m*r*r}" ixy="0" ixz="0" iyy="${(2/5)*m*r*r}" iyz="0" izz="${(2/5)*m*r*r}"/>
    </inertial>
  </xacro:macro>

  <xacro:macro name="box_inertia" params="m x y z">
    <inertial>
      <mass value="${m}"/>
      <inertia ixx="${(1/12)*m*(y*y+z*z)}" ixy="0" ixz="0" iyy="${(1/12)*m*(x*x+z*z)}" iyz="0" izz="${(1/12)*m*(x*x+y*y)}"/>
    </inertial>
  </xacro:macro>


  <link name="base_footprint"/>
 
  <joint name="base_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 ${wheel_radius + base_height/2}" rpy="0 0 0"/>
  </joint>

  <!-- 차체: 원형 → 사각형 (Box) -->
  <link name="base_link">
    <xacro:box_inertia m="${base_mass}" x="${base_length}" y="${base_width}" z="${base_height}"/>
    <visual>
      <geometry><box size="${base_length} ${base_width} ${base_height}"/></geometry>
      <material name="white"/>
    </visual>
    <collision>
      <geometry><box size="${base_length} ${base_width} ${base_height}"/></geometry>
    </collision>
  </link>

  <xacro:macro name="drive_wheel" params="prefix y_offset">
    <link name="${prefix}_wheel">
      <xacro:cylinder_inertia m="${wheel_mass}" r="${wheel_radius}" h="${wheel_width}"/>
      <visual>
        <geometry><cylinder radius="${wheel_radius}" length="${wheel_width}"/></geometry>
        <material name="dark_grey"/>
      </visual>
      <collision>
        <geometry><cylinder radius="${wheel_radius}" length="${wheel_width}"/></geometry>
      </collision>
    </link>
    <joint name="${prefix}_wheel_joint" type="continuous">
      <parent link="base_link"/>
      <child link="${prefix}_wheel"/>
      <origin xyz="0 ${y_offset} ${-base_height/2 + wheel_radius - 0.01}" rpy="${-pi/2} 0 0"/>
      <axis xyz="0 0 1"/>
      <dynamics damping="0.01" friction="0.1"/>
    </joint>
  </xacro:macro>

  <xacro:drive_wheel prefix="left" y_offset="${wheel_separation/2}"/>
  <xacro:drive_wheel prefix="right" y_offset="${-wheel_separation/2}"/>

  <link name="front_caster">
    <xacro:sphere_inertia m="${caster_mass}" r="${caster_radius}"/>
    <visual>
      <geometry><sphere radius="${caster_radius}"/></geometry>
      <material name="black"/>
    </visual>
    <collision>
      <geometry><sphere radius="${caster_radius}"/></geometry>
    </collision>
  </link>
  <joint name="front_caster_joint" type="fixed">
    <parent link="base_link"/>
    <child link="front_caster"/>
    <origin xyz="0.13 0 ${-base_height/2 - caster_radius + wheel_radius - 0.005}" rpy="0 0 0"/>
  </joint>

  <link name="lidar_link">
    <xacro:cylinder_inertia m="0.2" r="${lidar_size/2}" h="${lidar_height}"/>
    <visual>
      <geometry><cylinder radius="${lidar_size/2}" length="${lidar_height}"/></geometry>
      <material name="black"/>
    </visual>
    <collision>
      <geometry><cylinder radius="${lidar_size/2}" length="${lidar_height}"/></geometry>
    </collision>
  </link>
  <joint name="lidar_joint" type="fixed">
    <parent link="base_link"/>
    <child link="lidar_link"/>
    <origin xyz="${lidar_x_offset} 0 ${lidar_z_ground - (wheel_radius + base_height/2)}" rpy="0 0 3.14159"/>
  </joint>

  <link name="camera_link">
    <xacro:box_inertia m="0.1" x="${camera_size}" y="${camera_size*1.5}" z="${camera_size}"/>
    <visual>
      <geometry><box size="${camera_size} ${camera_size*1.5} ${camera_size}"/></geometry>
      <material name="red"/>
    </visual>
    <collision>
      <geometry><box size="${camera_size} ${camera_size*1.5} ${camera_size}"/></geometry>
    </collision>
  </link>
  <joint name="camera_joint" type="fixed">
    <parent link="base_link"/>
    <child link="camera_link"/>
    <origin xyz="${camera_x_offset} 0 ${camera_z_ground - (wheel_radius + base_height/2)}" rpy="0 0 0"/>
  </joint>
 
  <link name="imu_link">
    <inertial>
      <mass value="0.01"/>
      <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
    </inertial>
  </link>
 
  <joint name="imu_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="imu_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>
 
</robot>